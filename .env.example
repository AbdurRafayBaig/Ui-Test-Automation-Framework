# Copy to .env and adjust. Every value can also be passed on the command line.

# Target environment -> config/environments/<TEST_ENV>.json
TEST_ENV=qa

# chromium | firefox | webkit | chrome | msedge
BROWSER=chromium
HEADLESS=true
# Slow every Playwright action down by N ms (handy for demos/debugging)
SLOW_MO=0
VIEWPORT_WIDTH=1366
VIEWPORT_HEIGHT=768
# Optional device emulation, e.g. "iPhone 13" or "Pixel 7" (platform testing)
DEVICE=

# Artifacts: on | off | on-failure
SCREENSHOT=on-failure
VIDEO=off
TRACE=on-failure

# Parallel cucumber workers
PARALLEL=1
# Retry failing scenarios N times (useful in CI against public demo sites)
RETRY=0

# ---- Test data sources ----
EXCEL_DATA_FILE=test-data/test-data.xlsx
SQLITE_DATA_FILE=test-data/test-data.db
JSON_DATA_DIR=test-data/json
# Leave empty to use the built-in in-memory Redis (ioredis-mock) seeded from test-data/json
REDIS_URL=
# REDIS_URL=redis://localhost:6379

# Console verbosity (the full log is always attached to the Allure report)
LOG_LEVEL=warn
